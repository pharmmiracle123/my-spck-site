<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Freke Umoh | Singer Portfolio</title>

  <!-- Tailwind CDN -->
  <script src="https://cdn.tailwindcss.com"></script>

  <!-- Tailwind Config -->
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          animation: {
            float: 'float 4s ease-in-out infinite',
            fade: 'fade 1.5s ease-out forwards',
            move: 'move 15s linear infinite'
          },
          keyframes: {
            float: {
              '0%,100%': { transform: 'translateY(0)' },
              '50%': { transform: 'translateY(-15px)' }
            },
            fade: {
              '0%': { opacity: 0, transform: 'translateY(30px)' },
              '100%': { opacity: 1, transform: 'translateY(0)' }
            },
            move: {
              '0%': { transform: 'translateY(100vh)' },
              '100%': { transform: 'translateY(-100vh)' }
            }
          }
        }
      }
    }
  </script>
</head>

<body class="bg-gray-100 dark:bg-black text-gray-900 dark:text-white transition duration-500 overflow-x-hidden">

<!-- Background Guitar Animation -->
<div class="fixed inset-0 -z-10 overflow-hidden">
  <span class="absolute text-6xl opacity-10 left-10 animate-move">🎼</span>
  <span class="absolute text-5xl opacity-10 left-1/3 animate-move">🎙</span>
  <span class="absolute text-7xl opacity-10 left-2/3 animate-move">🎶</span>
</div>

<!-- Navbar -->
<header class="flex justify-between items-center p-6 max-w-7xl mx-auto">
  <h1 class="text-2xl font-bold">🎙 Freke</h1>

  <div class="flex items-center gap-4">
    <a href="#about" class="hover:text-yellow-400">About</a>
    <a href="#portfolio" class="hover:text-yellow-400">Portfolio</a>
    <a href="#contact" class="hover:text-yellow-400">Contact</a>

    <button onclick="toggleTheme()" class="px-3 py-1 rounded bg-yellow-400 text-black font-bold">
      🌙 / ☀️
    </button>
  </div>
</header>

<!-- Hero Section -->
<section class="max-w-7xl mx-auto px-6 py-20 grid md:grid-cols-2 gap-10 items-center animate-fade">
  <div>
    <h2 class="text-5xl font-extrabold mb-4">
      Freke Umoh
    </h2>
    <p class="text-2xl text-yellow-400 mb-6 font-semibold">
      Professional Music Artist
    </p>
    <p class="text-gray-600 dark:text-gray-300 leading-relaxed mb-6">
     Freke Umoh is a voice of passion and purpose, a singer who turns every stage into a story and every song into an experience. Through music, she inspires, uplifts, and connects people in ways that words alone cannot. Her artistry reminds us that when talent meets dedication, the power to move hearts and transform lives becomes limitless.
    </p>

    <div class="flex gap-4">
      <a href="#portfolio" class="px-6 py-3 bg-yellow-400 text-black rounded-full font-bold hover:scale-105 transition">
        View Work
      </a>
      <a href="#contact" class="px-6 py-3 border border-yellow-400 rounded-full font-bold hover:bg-yellow-400 hover:text-black transition">
        Contact Me
      </a>
    </div>
  </div>

  <div class="flex justify-center">
    <img
      src="images.jpeg"
      alt="Freke Umoh"
      class="w-80 h-80 object-cover rounded-2xl shadow-2xl animate-float hover:scale-105 transition"
    />
  </div>
</section>

<!-- About Section -->
<section id="about" class="max-w-6xl mx-auto px-6 py-16">
  <h3 class="text-3xl font-bold mb-6 text-center">About Me</h3>
  <p class="text-center max-w-3xl mx-auto text-gray-600 dark:text-gray-300">
    Freke Umoh creates melodies that stir the soul, lyrics that speak to the heart, and performances that leave a lasting impact on everyone who listens.
  </p>
</section>

<!-- Portfolio Section -->
<section id="portfolio" class="bg-gray-200 dark:bg-gray-900 py-16">
  <div class="max-w-6xl mx-auto px-6">
    <h3 class="text-3xl font-bold mb-10 text-center">Portfolio</h3>

    <div class="grid md:grid-cols-3 gap-6">
      <div class="p-6 bg-white dark:bg-black rounded-xl shadow-lg hover:scale-105 transition">
        🎵 Live Performances
      </div>
      <div class="p-6 bg-white dark:bg-black rounded-xl shadow-lg hover:scale-105 transition">
        🎧 Studio Sessions
      </div>
      <div class="p-6 bg-white dark:bg-black rounded-xl shadow-lg hover:scale-105 transition">
        🎼 Band Collaborations
      </div>
    </div>
  </div>
</section>

<!-- Contact / Social Media -->
<section id="contact" class="max-w-6xl mx-auto px-6 py-16 text-center">
  <h3 class="text-3xl font-bold mb-6">Connect With Me</h3>

  <div class="flex justify-center gap-6 text-3xl">
    <a href="#" class="hover:text-yellow-400">🌐</a>
    <a href="#" class="hover:text-yellow-400">📸</a>
    <a href="#" class="hover:text-yellow-400">🎵</a>
    <a href="#" class="hover:text-yellow-400">▶️</a>
  </div>

  <p class="mt-6 text-gray-600 dark:text-gray-400">
    Website Developer by Miracle | +2348169395022
  </p>
</section>

<!-- JavaScript -->
<script>
  function toggleTheme() {
    document.documentElement.classList.toggle('dark');
  }
</script>

</body>
</html>
